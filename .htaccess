# wizlink.bytopo.net · reglas del servidor (Hostinger).

# Siempre por https
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# La llave de subida llega en el encabezado Authorization: que PHP la reciba
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Lo que nunca se sirve: datos de git, notas y el código interno
RedirectMatch 404 /\.git
RedirectMatch 404 \.md$
RedirectMatch 404 ^/lib(/|$)
RedirectMatch 404 ^/pruebas(/|$)
RedirectMatch 404 /\.htaccess$

# Nunca listar el contenido de una carpeta
Options -Indexes
DirectoryIndex index.php

# Encabezados de seguridad también para los archivos sueltos (las páginas PHP los ponen ellas mismas)
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>

# El manifiesto de la app del teléfono
AddType application/manifest+json .webmanifest

# Una subida de hasta 64 MB (si el servidor deja cambiarlo desde aquí)
<IfModule mod_php.c>
  php_value upload_max_filesize 70M
  php_value post_max_size 70M
  php_value max_execution_time 300
</IfModule>
<IfModule lsapi_module>
  php_value upload_max_filesize 70M
  php_value post_max_size 70M
  php_value max_execution_time 300
</IfModule>
